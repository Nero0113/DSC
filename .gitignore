# Local environments and caches
.venv/
**/__pycache__/
*.py[cod]
.DS_Store

# User-provided datasets must never be committed
data/
datasets/
*.npz
*.npy
*.csv

# Local bundles and transient training files
*.zip
*.tmp

# Keep only the selected reproducibility artifacts from runs/
luna_temporal_classifier/runs/*
!luna_temporal_classifier/runs/inception_final_d1_d5_seed2026/
luna_temporal_classifier/runs/inception_final_d1_d5_seed2026/*
!luna_temporal_classifier/runs/inception_final_d1_d5_seed2026/final_model.pt
!luna_temporal_classifier/runs/inception_final_d1_d5_seed2026/metrics.json
!luna_temporal_classifier/runs/inception_final_d1_d5_seed2026/history.json

!luna_temporal_classifier/runs/hierarchical_context25_final_d1_d5_seed2026/
