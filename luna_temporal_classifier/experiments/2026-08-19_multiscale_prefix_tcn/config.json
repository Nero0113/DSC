{
  "architecture": "MultiScalePrefixTCN",
  "frozen_encoder": "InceptionTemporalNet(width=48, dropout=0.15)",
  "feature_dim": 128,
  "local_context": 25,
  "local_width": 64,
  "local_kernel": 3,
  "local_dilations": [1, 2, 4, 8],
  "global_ema_alphas": [0.25, 0.0625, 0.015625],
  "global_statistics": ["cumulative_mean", "cumulative_population_std"],
  "dropout": {
    "local": 0.2,
    "global": 0.25,
    "fusion": 0.25,
    "feature": 0.05
  },
  "batch_size": 256,
  "epochs": 60,
  "patience": 12,
  "optimizer": "AdamW",
  "learning_rate": 0.001,
  "weight_decay": 0.001,
  "warmup_epochs": 3,
  "cosine_min_learning_rate": 0.00002,
  "gradient_clip_norm": 1.0,
  "label_smoothing": 0.03,
  "auxiliary_loss_weights": {
    "local": 0.2,
    "global": 0.2
  },
  "seeds": [2026, 2027, 2028],
  "selection_metric": "D5 macro_f1",
  "split_contract": {
    "train": "D1-D4",
    "validation": "D5",
    "test": "not evaluated"
  }
}
